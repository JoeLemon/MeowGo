# ============================================================
# MeowGo（Excel执行喵）· Git 忽略规则
# 原则：源码 / 配置 / 文档 / 素材进仓库；运行时状态与构建产物不进仓库
# ============================================================

# ---- 运行时状态（程序实时写入，含本机绝对路径，自动重新生成）----
rpa_settings.json
images/

# ---- Python 字节码 / 缓存 ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- PyInstaller 打包产物（dist/ 约 170MB）----
dist/
build/
*.manifest

# ---- 测试 / 自检生成的预览图（README 引用的 gui_preview.png 除外）----
tests/*.png
!tests/gui_preview.png

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---- 环境变量 / 密钥（示例文件保留）----
.env
.env.*
!.env.example

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---- 日志 / 临时 / 备份 ----
*.log
*.tmp
*.temp
*.bak

# ---- WorkBuddy 项目数据（本地工作区元数据，不入库）----
.workbuddy/

backups/
reports/
tests/_shot_preview_dir/